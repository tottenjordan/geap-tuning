# Copy to .env and fill in. .env is git-ignored — never commit real values.

# 1. Google Cloud Platform Settings
PROJECT_ID=
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GCP_REGION=us-central1
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_PROJECT_NUMBER=

# 2. Model & AI Studio / Developer API Authentication
GOOGLE_API_KEY=
GEMINI_API_KEY=

# 3. Cloud Storage Resource
GCS_BUCKET_NAME=
BUCKET=
GOOGLE_CLOUD_STORAGE_BUCKET=

# 4. Resource Labels
# Attached to every resource this repo creates (tuning jobs + their generated
# Model/Endpoint, and Managed TensorBoard). Both must be set for the label to
# apply; unset one and labeling is a no-op. Lowercase letters/digits/_/- only,
# each <=64 chars. See docs/notes/resource-labels.md.
LABEL_KEY=project
LABEL_VALUE=geap-tuning

# 6. Re-runnable display names (optional)
# Appended to every example's tuning-job display name. Examples reuse a job by
# display name, but a job outlives the endpoint it produced — after reclaiming
# endpoint quota with scripts/cleanup_endpoints.sh, bump this (e.g. -v2) so a
# fresh job is launched instead of reusing one whose endpoint is gone.
# Lowercase letters, digits and hyphens only, max 32 chars. Empty = unchanged.
GEAP_RUN_SUFFIX=

# 7. Logging (optional)
# The library logs operational messages (job state, reuse decisions, sweep
# progress) through Python logging; examples call configure_logging() to install
# a handler. Level defaults to INFO; format is `text` (human) or `json` (one
# object per line, for a log pipeline).
GEAP_LOG_LEVEL=
GEAP_LOG_FORMAT=
