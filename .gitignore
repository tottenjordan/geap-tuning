# Secrets / local config — never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/
.ty_cache/
.coverage
htmlcov/

# Generated datasets (a small sample.jsonl is committed explicitly)
datasets/**/*.jsonl

# Staged image datasets (e.g. multimodal SFT) + local eval artifacts — never
# commit raw images or generated metrics; scoped to datasets/ so docs/imgs/ is safe
datasets/**/*.jpg
datasets/**/*.jpeg
datasets/**/*.png
datasets/**/*.webp
datasets/**/*.csv

# Editors / OS
.DS_Store

# PaperBanana MCP diagram scratch runs (final images are copied into docs/imgs/)
outputs/
